# Dataset and derived arrays (not redistributed)
ciciot2023/
data/
*.npy
*.csv
archive*.zip

# Training outputs: results.csv, seed_summary.csv, history.pkl and
# figures/ are tracked on purpose, they are the evidence behind the
# paper's numbers and are tiny. Model checkpoints (*.pt) are NOT
# tracked: with the client split and weight init now seeded, any
# checkpoint can be regenerated exactly from the code, the data and
# the seed, so storing the binary weights themselves would only add
# repeated dead weight to the repo across every rerun and variant.
runs/*.pt
*.pt

# LaTeX build artifacts
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Internal working notes - not for distribution
REVIEW_NOTES.md
RESEARCH_ASSESSMENT.md
CODE_VERIFICATION.md

# Manuscript source is kept out of the public repository while the
# paper is under review, so that a public copy of the full text does
# not surface in similarity screening. Figures are retained.
paper/*.tex
*.tex
